{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://x07.io/schemas/x07.mcp.corpus.result.schema.json",
  "title": "x07.mcp.corpus.result@0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "tool", "tool_version", "ok", "details", "outputs"],
  "properties": {
    "schema_version": { "const": "x07.mcp.corpus.result@0.2.0" },
    "generated_at": { "type": "string" },
    "tool": { "type": "string" },
    "tool_version": { "type": "string" },
    "ok": { "type": "boolean" },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "server_id", "status", "score_truth_status", "source", "scores"],
      "properties": {
        "report_id": { "type": "string" },
        "server_id": { "type": "string" },
        "status": { "type": "string" },
        "score_truth_status": { "type": "string" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repo", "version"],
          "properties": {
            "repo": { "type": "string" },
            "version": { "type": "string" }
          }
        },
        "scores": { "$ref": "#/$defs/dim_scores" }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["out_dir", "scan_json"],
      "properties": {
        "out_dir": { "type": "string" },
        "scan_json": { "type": "string" }
      }
    }
  },
  "$defs": {
    "dim_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conformance", "security", "performance", "trust", "reliability", "overall"],
      "properties": {
        "conformance": { "type": ["integer", "null"] },
        "security": { "type": ["integer", "null"] },
        "performance": { "type": ["integer", "null"] },
        "trust": { "type": ["integer", "null"] },
        "reliability": { "type": ["integer", "null"] },
        "overall": { "type": ["integer", "null"] }
      }
    }
  }
}
