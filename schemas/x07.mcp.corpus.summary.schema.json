{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://x07.io/schemas/x07.mcp.corpus.summary.schema.json",
  "title": "x07.mcp.corpus.summary@0.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "tool", "tool_version", "ok", "details"],
  "properties": {
    "schema_version": { "const": "x07.mcp.corpus.summary@0.3.0" },
    "generated_at": { "type": "string" },
    "tool": { "type": "string" },
    "tool_version": { "type": "string" },
    "ok": { "type": "boolean" },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "results", "counts", "dimension_averages", "tool_shadowing"],
      "properties": {
        "report_id": { "type": "string" },
        "results": { "type": "array", "items": { "$ref": "#/$defs/result_ref" } },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "ok", "failed"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "ok": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 }
          }
        },
        "dimension_averages": { "$ref": "#/$defs/dim_scores" },
        "tool_shadowing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["collision_count", "tools"],
          "description": "cross-server tool-name collisions across the corpus targets (a shadowing risk if wired into one agent)",
          "properties": {
            "collision_count": { "type": "integer", "minimum": 0 },
            "tools": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  },
  "$defs": {
    "dim_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conformance", "security", "performance", "trust", "reliability", "overall"],
      "properties": {
        "conformance": { "type": ["integer", "null"] },
        "security": { "type": ["integer", "null"] },
        "performance": { "type": ["integer", "null"] },
        "trust": { "type": ["integer", "null"] },
        "reliability": { "type": ["integer", "null"] },
        "overall": { "type": ["integer", "null"] }
      }
    },
    "result_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server_id", "ok", "status", "score_truth_status", "scores", "result_path", "out_dir"],
      "properties": {
        "server_id": { "type": "string" },
        "ok": { "type": "boolean" },
        "status": { "type": "string" },
        "score_truth_status": { "type": "string" },
        "scores": { "$ref": "#/$defs/dim_scores" },
        "result_path": { "type": "string" },
        "out_dir": { "type": "string" }
      }
    }
  }
}
